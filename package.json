{
  "name": "fwdslsh-website",
  "version": "0.0.2",
  "description": "The official website for fwdslsh",
  "type": "module",
  "homepage": "https://fwdslsh.dev",
  "scripts": {
    "build": "unify build --clean --audit --strict",
    "dev": "unify dev",
    "check": "unify build --dry-run --strict",
