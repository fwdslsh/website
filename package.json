    "audit:external": "unify audit --external",
    "test": "playwright test"
  },
  "devDependencies": {
    "@fwdslsh/unify": "0.11.13",
    "@playwright/test": "^1.57.0",
    "unify-docs-template": "0.4.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
